{
  "name": "rosezm",
  "version": "0.1.9",
  "description": "Modular extensible full-stack framework for web and embedded applications, crafted with extreme romance and polished developer experience.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli/index.ts dev example",
    "build": "tsx src/cli/index.ts build example",
    "preview": "tsx src/cli/index.ts preview example",
    "serve": "tsx src/cli/index.ts serve example",
    "pack": "node pack.mjs",
    "prepublishOnly": "npm run pack",
    "benchmark": "tsx tests/benchmark.ts",
    "test": "tsx src/cli/index.ts build example && tsx tests/test-client.ts",
    "test:cli": "node tests/test-cli.mjs",
    "test:e2e": "tsx tests/test-e2e.ts",
    "test:edge": "tsx tests/test-edge.ts",
    "test:harness": "tsx tests/test-harness.ts",
    "test:sliced": "tsx tests/test-sliced.ts",
    "test:go": "tsx src/cli/index.ts build example && node tests/test-go.mjs",
    "test:pack": "node tests/test-pack.mjs",
    "build:go": "go build -o rosezm-server ."
  },
  "bin": {
    "rosezm": "dist-cli/rosezm.mjs"
  },
  "exports": {
    "./edge": "./dist-cli/edge.mjs",
    "./runtime": "./dist-cli/runtime.mjs",
    "./compiler": "./dist-cli/compiler.mjs",
    "./test": "./dist-cli/test.mjs"
  },
  "files": [
    "dist-cli",
    "src/FRAMEWORK_VERSION",
    "src/types/rosezm.d.ts",
    "src/cli/content.ts",
    "src/cli/edge.ts",
    "src/cli/hot-vary.ts",
    "src/cli/origin.ts",
    "src/cli/prod-server.ts",
    "src/cli/shell.ts",
    "src/cli/shutdown.ts",
    "src/cli/validator.ts",
    "src/hash.ts",
    "src/runtime/db.ts",
    "src/runtime/index.ts",
    "src/runtime/lorawan.ts",
    "deploy/api",
    "deploy/cloudflare",
    "deploy/k8s",
    "deploy/netlify",
    "deploy/Dockerfile.node",
    "deploy/Dockerfile.static",
    "deploy/docker-compose.yml",
    "deploy/fly.toml",
    "deploy/netlify.toml",
    "deploy/server.cjs",
    "deploy/vercel.json",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "esbuild": "^0.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^29.1.1",
    "pg": "^8.23.0",
    "tsx": "^4.7.0",
    "typescript": "^5.6.0"
  }
}